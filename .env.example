# ==============================================================================
# MEDEASE - Environment Configuration
# Tagline: Read · Verify · Understand · Remember · Stay Safe
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=MEDEASE

# ------------------------------------------------------------------------------
# Backend & Database
# ------------------------------------------------------------------------------
# Default: Local SQLite database for zero-config startup
DATABASE_URL=sqlite:///./medease.db
# PostgreSQL / Supabase configuration:
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=prescriptions-private

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini)
# If credentials are omitted, MEDEASE seamlessly falls back to Demo Mode.
# ------------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_VISION_MODEL=gemini-2.5-flash
AI_TEXT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Optional Services
# ------------------------------------------------------------------------------
TRANSLATION_API_KEY=
TTS_API_KEY=
PHARMACY_API_KEY=

# ------------------------------------------------------------------------------
# Security & Networking
# ------------------------------------------------------------------------------
APP_ENV=development
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=10
